{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "^/favicon.ico$",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "^/robots.txt$",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
