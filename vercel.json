{
    "outputDirectory": "public",
    "installCommand": "echo 1 || true",
    "buildCommand": "echo 1 || true",
    "functions": {
        "api/*.php": {
            "runtime": "vercel-php@0.9.0"
        }
    },
    "routes": [
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        },
        {
            "src": "^/favicon.ico$",
            "dest": "/public/favicon.ico"
        },
        {
            "src": "^/robots.txt$",
            "dest": "/public/robots.txt"
        },
        {
            "src": "/public/(.*)",
            "dest": "/public/$1"
        }
    ]
}
